# Admin Panel Environment Variables

# Admin password for accessing the admin panel
ADMIN_PASSWORD=kayaplanet2024

# Google Analytics 4 Measurement ID
# To enable analytics:
# 1. Go to https://analytics.google.com
# 2. Create a new GA4 property
# 3. Copy the Measurement ID (starts with G-)
# 4. Uncomment and paste below:
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Enquiry emails via Web3Forms (browser submit; free keys reject server POSTs)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Enquiries are emailed to the address attached to that Web3Forms key
