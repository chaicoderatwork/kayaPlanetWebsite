# Admin Panel Environment Variables

# Admin password for accessing the admin panel
ADMIN_PASSWORD=kayaplanet2024

# Google Analytics 4 Measurement ID
# Analytics scripts only fire on https://www.kayaplanet.com
# (localhost, 127.0.0.1 and *.vercel.app previews are ignored).
# In GA4:
# 1. Mark enquiry_submit as a Key event — this is the primary conversion
# 2. Keep whatsapp_click / call_click as supporting contact events
# 3. Optional: Admin → Data filters → exclude internal IP / developer traffic
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Enquiry emails via Web3Forms (browser submit; free keys reject server POSTs)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Enquiries are emailed to the address attached to that Web3Forms key
